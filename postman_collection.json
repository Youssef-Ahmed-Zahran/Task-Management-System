{
  "info": {
    "name": "Task Management System API",
    "description": "API endpoints for the Task Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@task.dev\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"New\",\n  \"lastName\": \"User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@task.dev\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Project\",\n  \"description\": \"A sample project\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        },
        {
          "name": "Get Project",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "project_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Project\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "project_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "project_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Add Member to Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user_id_here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/:id/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":id", "members"],
              "variable": [
                {
                  "key": "id",
                  "value": "project_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Remove Member from Project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/:id/members/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":id", "members", ":userId"],
              "variable": [
                {
                  "key": "id",
                  "value": "project_id_here"
                },
                {
                  "key": "userId",
                  "value": "user_id_here"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/:pId/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":pId", "tasks"],
              "query": [
                { "key": "status", "value": "TODO", "disabled": true },
                { "key": "priority", "value": "HIGH", "disabled": true },
                { "key": "assigneeId", "value": "user_id", "disabled": true },
                { "key": "search", "value": "keyword", "disabled": true }
              ],
              "variable": [
                {
                  "key": "pId",
                  "value": "project_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Task\",\n  \"description\": \"Task description\",\n  \"status\": \"TODO\",\n  \"priority\": \"MEDIUM\",\n  \"assigneeId\": \"user_id_here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/:pId/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":pId", "tasks"],
              "variable": [
                {
                  "key": "pId",
                  "value": "project_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Get Task",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/:pId/tasks/:tId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":pId", "tasks", ":tId"],
              "variable": [
                {
                  "key": "pId",
                  "value": "project_id_here"
                },
                {
                  "key": "tId",
                  "value": "task_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/:pId/tasks/:tId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":pId", "tasks", ":tId"],
              "variable": [
                {
                  "key": "pId",
                  "value": "project_id_here"
                },
                {
                  "key": "tId",
                  "value": "task_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/:pId/tasks/:tId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":pId", "tasks", ":tId"],
              "variable": [
                {
                  "key": "pId",
                  "value": "project_id_here"
                },
                {
                  "key": "tId",
                  "value": "task_id_here"
                }
              ]
            }
          }
        }
