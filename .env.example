# This is a sample environment file.
# Copy this file to api/.env and replace the values with your actual configuration.
# DO NOT commit real secrets to version control.

# --- Database ---
# The connection string for your PostgreSQL database (e.g. Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Server Configuration ---
NODE_ENV=development
PORT=8080

# --- JWT Configuration ---
# Use a long random string (min 32 chars) for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# --- Client URL ---
# URL of your frontend application for CORS
CLIENT_URL=http://localhost:5173
